{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "engram lifecycle session-start --host=codex --plugin-root=\"${PLUGIN_ROOT}\"",
            "commandWindows": "engram lifecycle session-start --host=codex --plugin-root=\"${PLUGIN_ROOT}\"",
            "timeout": 10,
            "additionalContextLimit": 4096,
            "statusMessage": "Loading engram memory..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "engram lifecycle session-start --host=codex --plugin-root=\"${PLUGIN_ROOT}\"",
            "commandWindows": "engram lifecycle session-start --host=codex --plugin-root=\"${PLUGIN_ROOT}\"",
            "timeout": 10,
            "additionalContextLimit": 4096,
            "statusMessage": "Recovering engram context after compaction..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "engram capture prompt-hook --host=codex",
            "commandWindows": "engram capture prompt-hook --host=codex",
            "timeout": 2,
            "additionalContextLimit": 1024
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "engram capture subagent-hook --host=codex",
            "commandWindows": "engram capture subagent-hook --host=codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/stop.sh\"",
            "commandWindows": "engram checkpoint verify-stop --host=codex",
            "timeout": 3,
            "statusMessage": "Verifying engram memory checkpoint..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "engram lifecycle session-end --host=codex",
            "commandWindows": "engram lifecycle session-end --host=codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
